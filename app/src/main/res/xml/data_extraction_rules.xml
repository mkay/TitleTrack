<?xml version="1.0" encoding="utf-8"?>
<!--
  The same rules for Android 12 and above, which split the old one file in two: a cloud backup and a
  direct device-to-device transfer. The granted folder's uri is left out of both for the reason in
  backup_rules.xml — it means nothing on the phone it arrives at.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="storage.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="storage.xml" />
    </device-transfer>
</data-extraction-rules>
