<?xml version="1.0" encoding="utf-8"?>
<!--
  A launcher shortcut's icon: the tab's own white glyph on the launcher icon's tile, so the
  long-press menu reads as the app's. Adaptive, so the launcher masks it like the icon itself.
  The inset leaves the glyph 48dp of the 108dp layer, inside the 66dp every mask shows; a fraction
  rather than dp, because a shortcut icon is drawn at whatever size the launcher picks.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground>
        <inset android:drawable="@drawable/ic_tuning_fork" android:inset="27.8%" />
    </foreground>
</adaptive-icon>
